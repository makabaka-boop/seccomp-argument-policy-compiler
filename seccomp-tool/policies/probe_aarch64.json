{
  "arch": "aarch64",
  "default": {
    "errno": "5"
  },
  "rules": [
    {
      "syscall": 172,
      "action": "allow"
    },
    {
      "syscall": 57,
      "action": {
        "errno": "92"
      },
      "when": {
        "arg": {
          "arg": 0,
          "op": "eq",
          "value": "999999"
        }
      }
    },
    {
      "syscall": 23,
      "action": {
        "errno": "77"
      },
      "when": {
        "and": [
          {
            "arg": {
              "arg": 0,
              "op": "eq",
              "value": "77"
            }
          },
          {
            "arg": {
              "arg": 1,
              "op": "eq",
              "value": "88"
            }
          }
        ]
      }
    },
    {
      "syscall": 233,
      "action": {
        "errno": "88"
      },
      "when": {
        "arg": {
          "arg": 2,
          "op": "range",
          "min": "0",
          "max": "4"
        }
      }
    },
    {
      "syscall": 233,
      "action": {
        "errno": "66"
      },
      "when": {
        "not": {
          "or": [
            {
              "arg": {
                "arg": 2,
                "op": "gt",
                "value": "8"
              }
            },
            {
              "not": {
                "arg": {
                  "arg": 2,
                  "op": "le",
                  "value": "9"
                }
              }
            }
          ]
        }
      }
    },
    {
      "syscall": 23,
      "action": "allow",
      "when": {
        "and": [
          {
            "arg": {
              "arg": 0,
              "op": "lt",
              "value": "100"
            }
          },
          {
            "arg": {
              "arg": 1,
              "op": "lt",
              "value": "100"
            }
          }
        ]
      }
    },
    {
      "syscall": 57,
      "action": {
        "errno": "99"
      },
      "when": {
        "arg": {
          "arg": 1,
          "op": "range",
          "min": "1000",
          "max": "5000"
        }
      }
    },
    {
      "syscall": 57,
      "action": {
        "errno": "78"
      },
      "when": {
        "and": [
          {
            "arg": {
              "arg": 1,
              "op": "lt",
              "value": "100"
            }
          },
          {
            "not": {
              "arg": {
                "arg": 1,
                "op": "eq",
                "value": "50"
              }
            }
          }
        ]
      }
    },
    {
      "syscall": 93,
      "action": "allow"
    },
    {
      "syscall": 94,
      "action": "allow"
    },
    {
      "syscall": 64,
      "action": "allow"
    },
    {
      "syscall": 167,
      "action": "allow"
    }
  ]
}
